{
  "name": "veltra",
  "version": "0.1.0",
  "private": true,
  "description": "VELTRA — Intelligence Beyond the Market. Financial intelligence platform.",
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning apps/server/src/index.js",
    "dev": "node --no-warnings=ExperimentalWarning --watch apps/server/src/index.js",
    "migrate": "node --no-warnings=ExperimentalWarning packages/database/migrate.js",
    "create-admin": "node --no-warnings=ExperimentalWarning scripts/create-admin.js",
    "backup-db": "node --no-warnings=ExperimentalWarning scripts/backup-db.js",
    "test": "node --no-warnings=ExperimentalWarning --test \"tests/unit/*.test.js\" \"tests/api/*.test.js\"",
    "test:e2e": "node --no-warnings=ExperimentalWarning tests/e2e/run.js",
    "check": "node scripts/check.js"
  }
}
