# VELTRA configuration. Copy to .env and edit:   Copy-Item .env.example .env
# Never commit .env. Secrets live only here (or in your host's secret manager).

# --- Server ---
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
PUBLIC_URL=http://localhost:4000
DATABASE_FILE=data/veltra.db
# Set true only behind a reverse proxy (Nginx/Caddy) that sets X-Forwarded-For
TRUST_PROXY=false
SESSION_DAYS=7
# Must be true in production (HTTPS)
COOKIE_SECURE=false

# --- Market data ---
# demo = synthetic, always labelled DEMO.  http-feed = your licensed vendor bridge (see SETUP.md)
MARKET_PROVIDER=demo
MARKET_FEED_URL=
MARKET_FEED_API_KEY=
# true if your licence is for delayed data (UI shows DELAYED)
MARKET_FEED_DELAYED=false
MARKET_POLL_MS=3000
MARKET_STALE_AFTER_MS=15000
MARKET_MONITOR_START=09:10
MARKET_MONITOR_END=15:30
# Demo provider ignores market hours when true
DEMO_ALWAYS_OPEN=true

# --- AI narratives ---
# deterministic = built-in template engine (no external calls).  anthropic = Claude via API
AI_PROVIDER=deterministic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=2
AI_RATE_PER_MINUTE=30

# --- Payments ---
# sandbox = built-in test gateway (blocked in production).  razorpay = Razorpay
PAYMENT_PROVIDER=sandbox
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SANDBOX_PAYMENT_SECRET=change-me-for-local-testing

# --- Email delivery (optional) ---
# resend | sendgrid | postmark   (blank = queue to data/outbox only)
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=

# --- Android push via Firebase Cloud Messaging (optional) ---
# Path to the Firebase service-account JSON (keep it OUTSIDE the project folder)
FCM_SERVICE_ACCOUNT_FILE=

# --- Seller / GST (receipts become tax invoices when SELLER_GSTIN is set) ---
SELLER_LEGAL_NAME=
SELLER_ADDRESS=
SELLER_GSTIN=
SELLER_STATE_CODE=
GST_RATE=18

# --- Google sign-in (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Abuse protection ---
# Multiplies every rate limit (1 = defaults)
RATE_LIMIT_SCALE=1
