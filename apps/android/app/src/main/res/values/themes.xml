<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Veltra" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/crimson</item>
        <item name="colorPrimaryDark">@color/obsidian</item>
        <item name="colorAccent">@color/rose_gold</item>
        <item name="android:windowBackground">@color/obsidian</item>
        <item name="android:statusBarColor">@color/obsidian</item>
        <item name="android:navigationBarColor">@color/obsidian</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_2</item>
    </style>

    <!-- Android 12+ splash screen (back-ported by core-splashscreen) -->
    <style name="Theme.Veltra.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/obsidian</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenAnimationDuration">800</item>
        <item name="postSplashScreenTheme">@style/Theme.Veltra</item>
    </style>
</resources>
